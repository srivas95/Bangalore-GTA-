  {
   "id": "delivery",
   "title": "Fast Delivery",
   "act": "Act I · Majestic",
   "giver": "babu",
   "reward": 500,
   "steps": [
    {
     "type": "talk",
     "lines": [
      {
       "who": "Babu",
       "text": "Raghu! You do deliveries, no? One parcel, Chickpete. Cash on the spot, no app commission."
      },
      {
       "who": "Raghu",
       "text": "What's in it?"
      },
      {
       "who": "Babu",
       "text": "Mobile covers. Very fragile mobile covers. Two and a half minutes, or the customer gets angry."
      }
     ]
    },
    {
     "type": "go",
     "place": "den",
     "text": "Get the parcel to the lodge in Chickpete.",
     "radius": 3.5,
     "timer": 167,
     "vehicleVar": null,
     "slow": true,
     "failText": "The parcel was late. Kotte Kumar doesn't like late."
    },
    {
     "type": "talk",
     "lines": [
      {
       "who": "Kotte Kumar",
       "text": "So you're the delivery boy. Babu says you're fast."
      },
      {
       "who": "Kotte Kumar",
       "text": "Fast is good. Quiet is better. You know who I am?"
      },
      {
       "who": "Raghu",
       "text": "Everyone in Chickpete knows who you are, sir."
      },
      {
       "who": "Kotte Kumar",
       "text": "Good answer. Come back tomorrow. I have proper work."
      }
     ]
    }
   ],
   "after": null
  },
